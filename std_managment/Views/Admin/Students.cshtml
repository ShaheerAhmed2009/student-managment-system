@model List<StdManagment.Models.Student>
@{
    ViewData["Title"] = "Admin Panel - Students";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h3 class="mb-0">Registered Students</h3>
    <form method="get" class="d-flex" style="gap:8px">
        <input type="text" name="search" value="@ViewBag.Search" class="form-control"
               placeholder="Search name, email, phone, ID" />
        <button type="submit" class="btn btn-outline-primary">Search</button>
    </form>
</div>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success">@TempData["Success"]</div>
}

<div class="row mb-3">
    <div class="col-md-3">
        <div class="card text-center">
            <div class="card-body">
                <div class="text-muted">Total Students</div>
                <div class="fs-3 fw-bold">@ViewBag.Total</div>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card text-center">
            <div class="card-body">
                <div class="text-muted">Active Now</div>
                <div class="fs-3 fw-bold text-success">@ViewBag.ActiveCount</div>
            </div>
        </div>
    </div>
</div>

<div class="table-responsive">
    <table class="table table-striped table-hover align-middle">
        <thead class="table-dark">
            <tr>
                <th>#</th>
                <th>Student ID</th>
                <th>Name</th>
                <th>Email</th>
                <th>Phone</th>
                <th>Registered</th>
                <th>Last Login</th>
                <th>Status</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            @if (!Model.Any())
            {
                <tr><td colspan="9" class="text-center text-muted">No students found.</td></tr>
            }
            @{
                var n = 1;
            }
            @foreach (var s in Model)
            {
                <tr>
                    <td>@(n++)</td>
                    <td>@s.StudentId</td>
                    <td>@s.FullName</td>
                    <td>@s.Email</td>
                    <td>@s.Phone</td>
                    @* Pakistan time is UTC+5 (no daylight saving) *@
                    <td>@s.CreatedAt.AddHours(5).ToString("dd MMM yyyy, hh:mm tt")</td>
                    <td>
                        @(s.LastLoginAt.HasValue
                            ? s.LastLoginAt.Value.AddHours(5).ToString("dd MMM yyyy, hh:mm tt")
                            : "Never")
                    </td>
                    <td>
                        @if (s.IsActive)
                        {
                            <span class="badge bg-success">Active</span>
                        }
                        else
                        {
                            <span class="badge bg-secondary">Inactive</span>
                        }
                    </td>
                    <td>
                        <form asp-action="Delete" asp-route-id="@s.Id" method="post"
                              onsubmit="return confirm('Delete this student?');">
                            <button type="submit" class="btn btn-sm btn-outline-danger">Delete</button>
                        </form>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>
